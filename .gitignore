# ---------------------------------------------------------------
# 运行时数据与凭证（绝不入库）
# ---------------------------------------------------------------
# 真实 token / 手机号写在这里，只留在本机
data/config.json
data/mobile.txt
# 平台电柜档案缓存（自动生成）
data/profiles.json
# 历史采样库（自动生成，体积大）
data/watch.db
data/watch.db-shm
data/watch.db-wal
data/*.db
data/*.db-shm
data/*.db-wal
# 陈旧进程标记
data/server.pid
# 点位配置必须入库（6 个点位归并表，无个人信息）
!data/sites.json

# ---------------------------------------------------------------
# 打包与构建产物
# ---------------------------------------------------------------
dist_包/
_charge.spec

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------
# 开发自检 / 抓包 / 调试产物
# ---------------------------------------------------------------
# 含 Chrome 用户配置（Login Data 等），泄露浏览器登录态
web/.selfcheck/

# 根目录下的开发临时产物统一以 _ 开头（_api*.py、_shot_*.mjs、_*.png …）
/_*

# 抓包与调试遗物
*.log
*.pcap
*.har

# 地图瓦片调试目录
/_tiles*/
/_tx_tiles/
/_marker_imgs/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
