# 统一换行处理：仓库内存 LF，检出时按平台转换
* text=auto

# 源码 / 文档 / 前端资源：仓库内一律 LF
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Windows 批处理必须是 CRLF，否则 cmd.exe 解析会出问题
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制资源不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.db    binary
*.exe   binary
*.zip   binary
